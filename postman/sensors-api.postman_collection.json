{
  "info": {
    "name": "sensors-api (Lab 1)",
    "description": "CRUD-запити для давачів температури (/sensors) та вологості (/humidity-sensors).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tempId", "value": "" },
    { "key": "humId", "value": "" }
  ],
  "item": [
    {
      "name": "CheckServerWorking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Hello World', () => pm.expect(pm.response.text()).to.include('Hello World'));"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "Temperature sensors",
      "item": [
        {
          "name": "Create temperature sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.collectionVariables.set('tempId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Temp\",\n  \"value\": 27,\n  \"unit\": \"C\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/sensors"
          }
        },
        {
          "name": "Get all temperature sensors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/sensors" }
        },
        {
          "name": "Get temperature sensor by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('tempId')));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/sensors/{{tempId}}" }
        },
        {
          "name": "Update temperature sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Value updated', () => pm.expect(pm.response.json().value).to.eql(30));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/sensors/{{tempId}}"
          }
        },
        {
          "name": "Delete temperature sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/sensors/{{tempId}}" }
        },
        {
          "name": "Get deleted temperature sensor (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/sensors/{{tempId}}" }
        }
      ]
    },
    {
      "name": "Humidity sensors",
      "item": [
        {
          "name": "Create humidity sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.collectionVariables.set('humId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Hum-1\",\n  \"value\": 45.5,\n  \"unit\": \"%\",\n  \"location\": \"Lab 301\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/humidity-sensors"
          }
        },
        {
          "name": "Create humidity sensor - invalid value (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Hum-bad\",\n  \"value\": 150,\n  \"unit\": \"%\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/humidity-sensors"
          }
        },
        {
          "name": "Get all humidity sensors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/humidity-sensors" }
        },
        {
          "name": "Get humidity sensor by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('humId')));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/humidity-sensors/{{humId}}" }
        },
        {
          "name": "Update humidity sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Value updated', () => pm.expect(pm.response.json().value).to.eql(60));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 60\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/humidity-sensors/{{humId}}"
          }
        },
        {
          "name": "Delete humidity sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/humidity-sensors/{{humId}}" }
        },
        {
          "name": "Get deleted humidity sensor (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/humidity-sensors/{{humId}}" }
        }
      ]
    }
  ]
}
